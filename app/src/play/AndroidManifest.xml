<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play edition: Google Play installs updates, and the home screen has one banner ad. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Never self-install: removed even if a library were to request it. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <application>
        <!-- AdMob app ID (Google's test ID unless -Phandoff.admobAppId is set). The consent form needs it here. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
    </application>
</manifest>
