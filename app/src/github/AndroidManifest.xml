<?xml version="1.0" encoding="utf-8"?>
<!-- GitHub edition: installs its own signed updates from GitHub Releases. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Installing a downloaded, signature-checked update (Android still asks the user to confirm). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Hands a downloaded update to the system installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
